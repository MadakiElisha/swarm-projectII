<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_vehicle</name>
  <version>0.2.0</version>
  <description>Per-drone vehicle authority: safety FSM between the brain and the flight controller</description>
  <maintainer email="stefannelisha@gmail.com">Madaki Elisha</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>swarm_common</exec_depend>
  <exec_depend>swarm_backends</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
